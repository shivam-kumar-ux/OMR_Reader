# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=supersecret-omr-app-key-change-in-production-2026-secure!
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQL Server via pymssql, or sqlite fallback for local unit tests)
# For local SQL Server container:
DATABASE_URL=mssql+pymssql://sa:YourStrong%40Passw0rd@localhost:1433/omr_db
# For Azure SQL Server / Serverless:
# DATABASE_URL=mssql+pymssql://adminuser:password@myserver.database.windows.net:1433/omr_db?charset=utf8
# For local test / development without docker:
# DATABASE_URL=sqlite:///./omr_local.db

# Storage Configuration: "local", "azure_blob", or "vercel_blob"
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_WATCH_DIR=./scans_input

# Azure Blob Settings (if STORAGE_PROVIDER=azure_blob)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=omr-sheets

# Vercel Blob Settings (if STORAGE_PROVIDER=vercel_blob)
BLOB_READ_WRITE_TOKEN=

# OMR & Accuracy Thresholds
CONFIDENCE_THRESHOLD_AUTO_ACCEPT=0.88
BUBBLE_FILL_THRESHOLD=0.35
BUBBLE_UNCERTAIN_LOW=0.20
BUBBLE_UNCERTAIN_HIGH=0.35
OCR_NAME_SIMILARITY_THRESHOLD=0.75
