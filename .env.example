# ==============================================================================
# OMR Optical Mark Recognition System - Environment Variables Configuration
# ==============================================================================

# Application & Environment
APP_NAME="OMR Recognition System"
ENVIRONMENT="development"
DEBUG=True
APP_SECRET_KEY="replace-with-a-secure-random-64-char-hex-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (SQL Server / Azure SQL / Local SQLite)
# SQL Server Container / Azure SQL connection format:
# mssql+pymssql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="mssql+pymssql://sa:YourStrong!Passw0rd@localhost:1433/omr_db"

# Local SQLite fallback for lightweight development / testing:
# DATABASE_URL="sqlite:///./omr_local.db"

# Storage Configuration ('local', 'vercel_blob', 'azure_blob')
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage/omr_sheets"
STORAGE_WATCH_DIR="./scans_input"

# Vercel Blob Storage (Production Vercel deployment)
BLOB_READ_WRITE_TOKEN=""

# Azure Blob Storage (Production Azure deployment)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="omr-sheets"

# OMR Accuracy & Decision Thresholds
CONFIDENCE_THRESHOLD_AUTO_ACCEPT=0.88
BUBBLE_FILL_THRESHOLD=0.45
BUBBLE_UNCERTAIN_LOW=0.30
BUBBLE_UNCERTAIN_HIGH=0.45
OCR_NAME_SIMILARITY_THRESHOLD=0.75

# CORS Origins (Comma-separated for multiple origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"
